# Public release allowlist. Local datasets, tests and runtime files stay local.
/*
!/.gitignore
!/README.md
!/VariantCalling2026.png
!/LICENSE
!/LICENSE.*
!/config/
/config/*
!/config/config.yaml
!/config/samples_examples.tsv
!/workflow/
/workflow/*
!/workflow/Snakefile
!/workflow/common.py
!/workflow/envs/
/workflow/envs/*
!/workflow/envs/bwa_samtools.yaml
!/workflow/envs/fastp.yaml
!/workflow/envs/gatk.yaml
!/workflow/envs/htslib.yaml
!/workflow/envs/vcfops.yaml
!/workflow/rules/
/workflow/rules/*
!/workflow/rules/*.smk
!/workflow/scripts/
/workflow/scripts/*
!/workflow/scripts/*.py
!/docs/
/docs/*
!/docs/gvcf_reuse.md
!/docs/filter_validation.md
**/__pycache__/
*.pyc
*_old*
*.log

# Explicit local-only directories.
/tests/
/.snakemake/
/logs/
/tmp/
/data/
/results/
